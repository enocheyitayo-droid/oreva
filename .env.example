NODE_ENV=development
HOST=127.0.0.1
PORT=3100
BASE_URL=http://127.0.0.1:3100
DATABASE_PATH=./data/store.sqlite
# disabled (default), development (local only), or paystack (TEST keys only).
PAYMENT_ADAPTER=disabled
PAYSTACK_SECRET_KEY=
# This build intentionally rejects live Paystack keys.
EMAIL_ADAPTER=development
RESEND_API_KEY=
EMAIL_FROM=
# Used only by npm run owner; remove from environment after provisioning.
OWNER_EMAIL=
OWNER_PASSWORD=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional one-time hosted owner setup. Generate a random private value >=32 chars.
OWNER_SETUP_CODE=
# Netlify build only: persistent backend HTTPS origin (not a secret).
BACKEND_ORIGIN=
